{
  "name": "asshole-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "test": "npm run test -w shared && npm run test -w server && npm run test -w client",
    "dev": "npm run dev -w server",
    "typecheck": "npm run typecheck -w shared && npm run typecheck -w server && npm run typecheck -w client",
    "start": "npm run start -w server",
    "build": "npm run build -w client",
    "dev:client": "npm run dev -w client",
    "e2e": "npm run build && node e2e/mobile.e2e.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright-core": "1.64.0"
  }
}
